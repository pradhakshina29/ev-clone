# Copy to backend/.env and replace every REPLACE_ME. Never commit backend/.env.
NODE_ENV=development
PORT=8081
MONGODB_URI=mongodb+srv://ev_app:REPLACE_ME@REPLACE_ME.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ev_companion
# Signs login tokens. Generate it with the command in backend/README.md; at least 32 characters.
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:5100,http://localhost:5000
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-flash-latest
# Optional: tried once when GEMINI_MODEL is overloaded (503) or rate limited (429).
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_CLIENT_SECRET=REPLACE_ME
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Demo-only conversion for PayPal Sandbox (USD per 1 INR), same as functions/card_backend.js.
DEMO_EXCHANGE_RATE_INR_TO_USD=0.012

